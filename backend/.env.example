# BizPilot AI Backend Environment Configuration
# Copy this file to backend/.env and replace placeholders before running.
# Never commit backend/.env or real credentials to version control.

APP_NAME="BizPilot AI API"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG="true"
LOG_LEVEL="INFO"

# Primary Production Database (PostgreSQL via psycopg v3 — postgres:// and postgresql:// are auto-normalized):
# DATABASE_URL="postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/bizpilot_ai"

# Local Development / Testing Fallback (SQLite):
DATABASE_URL="sqlite:///./bizpilot_dev.db"
ALLOW_SQLITE_IN_PRODUCTION="false"
DB_ECHO="false"

# JWT Signing Secret (generate a strong 32+ char random string in staging/production)
JWT_SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Comma-separated allowed frontend origins for CORS (never use "*" in production)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Host header allowlist (set to your API domain / "*.onrender.com" in production)
TRUSTED_HOSTS="*"
PROXY_HEADERS_ENABLED="true"

# Google Gemini AI Configuration (backend-only; never expose in frontend VITE_* vars)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_TIMEOUT_SECONDS="25.0"
COPILOT_RATE_LIMIT_REQUESTS="20"
COPILOT_RATE_LIMIT_WINDOW_SECONDS="60"

# Optional Redis URL for distributed multi-instance rate limiting (falls back to PostgreSQL table)
REDIS_URL=""
